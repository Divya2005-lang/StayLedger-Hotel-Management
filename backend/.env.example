# Copy to .env and adjust.
PORT=5000

# Either a single connection string...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stayledger

# ...or leave DATABASE_URL empty and use the discrete PG* variables instead.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=stayledger

# Origin(s) allowed to call the API from a browser (comma separated).
# Not needed in dev because the Vite proxy makes requests same-origin.
CORS_ORIGIN=http://localhost:5173

# Max image size in megabytes
MAX_IMAGE_MB=5

# ---- Admin access: only the admin can add, edit or delete hotels ----
ADMIN_USERNAME=admin

# Recommended: store a hash instead of the password. Create one with
#   npm run admin:hash -- "your long passphrase"
# and paste the printed line here.
# ADMIN_PASSWORD_HASH=

# Local development shortcut. Change it. Not accepted when NODE_ENV=production.
ADMIN_PASSWORD=change-this-password

# Secret used to sign login tokens. Use a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty in development, a temporary one is used and logins reset on restart.
AUTH_SECRET=

# Hours a login stays valid (default 8)
TOKEN_TTL_HOURS=8

# Set to true only when the API runs behind a reverse proxy (so login limits use the real client IP).
# TRUST_PROXY=true
